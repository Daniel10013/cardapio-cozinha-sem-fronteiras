# ---------------------------------------------------------------------------
# Variáveis de ambiente — Cozinha Sem Fronteiras
#
# Copie este arquivo para ".env.local" para rodar localmente (nunca commite
# o ".env.local" — ele já está no .gitignore). Na Vercel, cadastre as mesmas
# chaves em Project Settings > Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Painel do Supabase > Project Settings > API

# URL do projeto (pode ficar pública, é só o endereço)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "anon/public" (pode ficar pública)
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-chave-anon-aqui

# Chave "service_role" — NUNCA exponha no navegador, NUNCA use prefixo
# NEXT_PUBLIC_ nela. Usada só nas rotas de servidor (app/api/**).
SUPABASE_SERVICE_ROLE_KEY=coloque-a-chave-service-role-aqui

# --- Sessão / segurança -------------------------------------------------
# Uma string longa e aleatória, só sua, usada para assinar o cookie de
# login do painel administrativo. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Senha inicial do painel administrativo (usada só na primeira vez que o
# sistema roda, para criar o hash salvo no banco). Troque pelo painel depois.
ADMIN_INITIAL_PASSWORD=admin123

# --- Endereço público do site --------------------------------------------
# Usado para gerar os QR Codes das mesas. Em produção, é a URL da Vercel
# (ex: https://cozinha-sem-fronteiras.vercel.app) ou seu domínio próprio.
# Em desenvolvimento local, pode deixar http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
